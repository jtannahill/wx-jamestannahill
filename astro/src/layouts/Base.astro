---
interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description, canonical, ogTitle, ogDescription, ogImage, ogImageAlt } = Astro.props;
const og = {
  title: ogTitle ?? title,
  description: ogDescription ?? description,
  // Default is the static brand card: a page without its own live card must
  // not hand scrapers a reading they will cache and show for weeks.
  image: ogImage ?? 'https://wx.jamestannahill.com/og.png?card=brand',
  imageAlt: ogImageAlt ?? 'wx.jamestannahill.com, live weather from a private station in Midtown Manhattan',
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="James Tannahill" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="wx.jamestannahill.com" />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:image" content={og.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={og.imageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <!--
      X card. The image is already at X's recommended 1200x630 / under 5MB
      for summary_large_image, so the only thing missing was site attribution:
      X renders the "@handle" byline on a large-image card from twitter:site,
      not twitter:creator, so without it the creator tag was inert.
      twitter:title is capped at 70 chars and description at 200 by X.
    -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og.title} />
    <meta name="twitter:description" content={og.description} />
    <meta name="twitter:image" content={og.image} />
    <meta name="twitter:image:alt" content={og.imageAlt} />
    <meta name="twitter:site" content="@jamestannahill" />
    <meta name="twitter:creator" content="@jamestannahill" />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="ai" href="/llms.txt" />

    <link rel="preconnect" href="https://fonts.jamestannahill.com" crossorigin />
    <link rel="preconnect" href="https://api.wx.jamestannahill.com" crossorigin />

    <link rel="stylesheet" href="https://fonts.jamestannahill.com/nhg-display.css" />
    <link rel="stylesheet" href="/style.css" />

    <slot name="schema" />

    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-WRDEHD4QYL"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WRDEHD4QYL');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
