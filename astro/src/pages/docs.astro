    .docs-flow span { display: block; font-size: 11px; color: var(--faint); margin-top: 4px; line-height: 1.35; }
    .docs-flow li + li::before {
      content: ''; position: absolute; left: -5px; top: 50%;
      width: 7px; height: 7px; margin-top: -4px;
