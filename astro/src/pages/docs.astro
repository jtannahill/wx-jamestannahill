          if (typeof h.data_age_minutes === 'number') {
            var mins = Math.max(0, Math.round(h.data_age_minutes));
            document.getElementById('live-age-text').textContent =
              mins < 1 ? 'Latest just now' : 'Latest ' + mins + ' min ago';
            document.getElementById('live-age').hidden = false;
          }
          var m = h.models && h.models.rain_probability;
          if (!m || m.f1 == null) return;
          if (m.trained_at) set('trained', fmtDate.format(new Date(m.trained_at)));
          set('samples', m.training_samples.toLocaleString('en-US'));
          set('f1', m.f1.toFixed(3));
          if (m.recall != null) set('recall', pct(m.recall));
          if (m.precision != null) set('precision', pct(m.precision));
        })
        .catch(function () {});
    })();
  </script>
</Base>
