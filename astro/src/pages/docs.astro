---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SchemaOrgDocs from '../components/SchemaOrgDocs.astro';
import AskAi from '../components/AskAi.astro';

const API = 'https://api.wx.jamestannahill.com';

const contents = [
  { label: 'Station', items: [
    ['pipeline', 'Pipeline at a glance'],
    ['cathaus', 'The CatHaus station'],
    ['validation', 'Source validation'],
    ['backfill', 'Historical backfill'],
  ] },
  { label: 'Climate context', items: [
    ['era5', 'ERA5 baselines'],
    ['today-in-history', 'Today in history'],
    ['anomaly-scoring', 'Anomaly scoring'],
    ['seasonal-uhi', 'Seasonal UHI curve'],
    ['chart-bands', 'Chart anomaly bands'],
  ] },
  { label: 'Signals and models', items: [
    ['signals', 'Signals'],
    ['rain-model', 'Rain probability model'],
    ['spatial-rain-boost', 'Spatial rain boost'],
    ['analog-forecast', 'Analog forecast'],
    ['forecast-accuracy', 'Forecast accuracy'],
    ['alerts', 'Weather alerts'],
    ['daily-summaries', 'Daily summaries'],
    ['station-records', 'Station records'],
    ['rain-events', 'Rain events'],
  ] },
  { label: 'Network and API', items: [
    ['external', 'External sources'],
    ['nearby', 'Nearby stations'],
    ['api', 'API reference'],
    ['downsampling', 'Downsampling'],
    ['infrastructure', 'Infrastructure'],
  ] },
];

const endpointGroups = [
  { label: 'Live', rows: [
    ['/current', '/current', 'Latest reading with every in-house signal: condition, anomalies, percentile rank, comfort score, rain probability, UHI delta and seasonal curve, analog forecast, yesterday’s summary, this month’s records, nearby network, and <code>climate_context</code> (NOAA GHCN verdict and ERA5 hourly percentile).'],
    ['/nearby', '/nearby', 'Most recent snapshot of nearby Manhattan personal weather stations.'],
    ['/alerts', '/alerts', 'Active NWS alerts for the station’s area.'],
  ] },
  { label: 'History', rows: [
    ['/history?hours=N', '/history?hours=24', 'Last N hours of readings (default 24, max 720), downsampled for longer ranges. Each reading carries <code>baseline_&#123;field&#125;</code> and <code>baseline_std_&#123;field&#125;</code> for the chart overlay and ±1σ band.'],
    ['/rain-events?days=N', '/rain-events?days=30', 'Rain events from the last N days (default 30, max 90), each with <code>start</code>, <code>duration_min</code>, <code>total_in</code> and <code>peak_rate</code>.'],
    ['/daily-summaries?days=N', '/daily-summaries?days=30', 'Daily summaries from the last N days (default 30, max 365): high, low and average temperature, total rain, max gust, average comfort score and a prose summary.'],
    ['/export?days=N&format=csv', '/export?days=1&format=csv', 'Raw readings for the last N days (default 7, max 90) as <code>json</code> (default) or <code>csv</code>.'],
  ] },
  { label: 'Derived', rows: [
    ['/forecast', '/forecast', 'Analog forecast for the next 3 hours, with its running accuracy once enough evaluations exist.'],
    ['/records', '/records', 'Station records: highs, lows, gusts, rain rate and pressure extremes.'],
    ['/climate-context', '/climate-context', 'NOAA GHCN and ERA5 climate context for today.'],
  ] },
  { label: 'Meta', rows: [
    ['/health', '/health', 'Data freshness, poller health and the rain model’s current training metrics.'],
    ['/openapi.json', '/openapi.json', 'OpenAPI description of this API.'],
  ] },
];

const pipeline = [
  ['WS-2902', 'Sensor at the station'],
  ['Ambient cloud', 'Wi-Fi upload'],
  ['wx-poller', 'Every 5 minutes'],
  ['DynamoDB', '13 tables'],
  ['wx-api', 'On request'],
  ['CloudFront', '5-minute cache'],
  ['Dashboard', 'Cloudflare Worker'],
];
---
<Base
  title="How It Works, wx.jamestannahill.com"
  description="Technical documentation: how weather data is collected, processed, and served at wx.jamestannahill.com."
  canonical="https://wx.jamestannahill.com/docs"
>
  <SchemaOrgDocs slot="schema" />

  <style>
    .docs-body { max-width: 680px; --link-underline: #555; }
    h1 { font-size: 44px; font-weight: 400; letter-spacing: -0.025em; margin-bottom: 14px; line-height: 1.05; }
    h2 { font-size: 15px; letter-spacing: 0.1em; color: var(--text); margin: 64px 0 18px; font-weight: 500; scroll-margin-top: 24px; }
    h3 { font-size: 16px; font-weight: 500; line-height: 1.4; margin: 32px 0 10px; color: var(--text); text-wrap: balance; }
    p { font-size: 16px; line-height: 1.7; color: var(--text-2); margin-bottom: 16px; }
    .docs-body > p, .docs-body > ul, .docs-body > ol { max-width: 34em; }
    .lead { font-size: 17px; line-height: 1.65; color: var(--text-2); margin-bottom: 0; max-width: 60ch; }
    .docs-byline {
      font-size: 12px; color: var(--muted);
      margin-top: 18px; display: flex; flex-wrap: wrap; gap: 4px 16px;
    }
    .docs-byline a { color: var(--muted); text-decoration: none; border-bottom: 1px dotted var(--link-underline); }
    @media (hover: hover) and (pointer: fine) {
      .docs-byline a:hover { color: var(--accent); border-bottom-color: var(--accent); }
      .back-link:hover, .to-contents:hover { color: var(--accent); }
      .docs-body > p a:hover, .docs-body td a:hover, .docs-body li a:hover { text-decoration-color: var(--accent); }
      .docs-body .docs-contents a:hover { color: var(--accent); }
    }
    .docs-body > p a, .docs-body td a, .docs-body li a { color: var(--accent); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 3px; }
    h1, h2 { text-wrap: balance; }
    p, li { text-wrap: pretty; }
    p, td { overflow-wrap: break-word; }

    .docs-meta-strip, .docs-contents, .docs-flow {
      display: grid;
      gap: 1px;
    }
    .docs-meta-strip { grid-template-columns: 1fr 1fr 1fr 1.3fr; margin-top: 36px; }
    .docs-meta-cell, .docs-contents section, .docs-flow li {
      background: var(--surface);
      box-shadow: var(--hairline);
    }
    .docs-meta-cell { padding: 14px 16px; }
    .docs-meta-label, .docs-contents h2 {
      font-size: 11px; letter-spacing: 0.1em; color: var(--muted);
      font-weight: 500; margin: 0 0 6px; text-transform: uppercase;
    }
    .docs-meta-value { font-size: 14px; color: var(--text); letter-spacing: -0.005em; }
