      .docs-contents { grid-template-columns: repeat(2, 1fr); }
      .docs-contents section { padding: 12px 14px 14px; }
      .docs-contents li { padding: 5px 0; }
      .docs-flow { grid-template-columns: 1fr; }
      .docs-flow li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 12px 14px; }
