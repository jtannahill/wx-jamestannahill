---
import Base from '../layouts/Base.astro';
import SchemaOrgIndex from '../components/SchemaOrgIndex.astro';
import Chart from '../components/Chart.tsx';
import { env } from 'cloudflare:workers';

const API_BASE = (env as any)?.API_BASE ?? 'https://api.wx.jamestannahill.com';

let boot: any = null;
try {
  const res = await fetch(`${API_BASE}/current`, {
    signal: AbortSignal.timeout(2500),
    cf: { cacheTtl: 60, cacheEverything: true } as any,
  });
  if (res.ok) boot = await res.json();
} catch (_) {
  // SSR fetch failed → fall through to client-side fetch (existing behavior)
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// Empty-value placeholder, shared with app.js (EMPTY) and Chart.tsx.
const EMPTY = '--';
// Negative values use a true minus sign (U+2212); a rounded -0 drops its sign.
const minus = (s: string) => (/^-0*(\.0+)?$/.test(s) ? s.slice(1) : s.replace(/^-/, '\u2212'));
const fmt = (v: number | undefined | null, d = 1) =>
  v == null || Number.isNaN(Number(v)) ? EMPTY : minus(Number(v).toFixed(d));
// Markup for a reading: EMPTY renders visually but reads as "No reading".
const esc = (s: unknown) => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as Record<string, string>)[c]);
const reading = (s: unknown) => String(s).split(EMPTY).map(esc)
  .join(`<span aria-hidden="true">${EMPTY}</span><span class="sr-only">No reading</span>`);

const DIRS = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];
const compass = (deg: number | null | undefined) =>
  deg == null ? EMPTY : DIRS[Math.round(Number(deg) / 22.5) % 16];

const trendArrow = (t: string | undefined) =>
  t === 'rising' ? '↑ Rising' : t === 'falling' ? '↓ Falling' : '→ Steady';

// All SSR'd in °F. If the user has wx_celsius=1 in localStorage,
// app.js's renderCurrent() will re-paint in °C on hydration (same flash
// behavior as the hero today).
const heroTemp     = fmt(boot?.tempf, 0);
const heroFeels    = `Feels like ${fmt(boot?.feelsLike, 0)}°F`;
const heroCond     = boot?.condition ?? EMPTY;
// API strings join clauses with a middle dot; the page reads them as sentences.
const tidy = (s: string) => s.replace(/\s[\u00b7\u2014]\s/g, ', ');
const anomHead     = tidy(boot?.anomalies?.temp?.label ?? '');
const anomSub      = tidy(boot?.climate_context?.headline ?? '');
const monthName    = new Date().toLocaleString('en-US', { month: 'long', timeZone: 'America/New_York' });
const percentile   = boot?.percentile_rank?.label
  ? `Temp vs typical ${monthName}: ${boot.percentile_rank.label}`
  : '';

const windSpeed    = `${fmt(boot?.windspeedmph, 0)} mph`;
const windDetail   = boot?.winddir != null ? `From ${compass(boot.winddir)} (${fmt(boot.winddir, 0)}°)` : 'Direction unavailable';
const humidity     = `${fmt(boot?.humidity, 0)}%`;
const dewpoint     = `Dew point ${fmt(boot?.dewPoint, 0)}°F`;
const pressure     = `${fmt(boot?.baromrelin, 2)}"`;
const pressureT    = trendArrow(boot?.pressure_trend);
const uv           = fmt(boot?.uv, 0);
const solar        = `${fmt(boot?.solarradiation, 0)} W/m²`;
const rainHourly   = `${fmt(boot?.hourlyrainin, 2)}"`;
const rainDaily    = `Daily: ${fmt(boot?.dailyrainin, 2)}"`;
const windGust     = `${fmt(boot?.windgustmph, 0)} mph`;
const windDir      = compass(boot?.winddir);
const comfortScore = boot?.comfort?.score ?? EMPTY;
const comfortLabel = boot?.comfort?.label ?? EMPTY;
const rainProb     = boot?.rain_probability?.probability != null ? `${boot.rain_probability.probability}%` : EMPTY;
const rainProbLbl  = boot?.rain_probability?.label ?? EMPTY;
const uhiVal       = boot?.uhi_delta != null
  ? `${boot.uhi_delta >= 0 ? '+' : ''}${fmt(boot.uhi_delta, 1)}°F`
  : EMPTY;

// Cache-busting OG image URL: bucket the latest reading timestamp to the
// nearest 5 min (matches wx_poller's cadence). Crawlers (Twitter, FB, Slack,
// iMessage) cache OG images by URL - bumping ?v= forces a refetch when a
// new reading lands. Within a 5-min window the URL is stable, so the CF
// edge cache hits and the worker doesn't re-render unnecessarily.
const ogBucket = boot?.timestamp
  ? Math.floor(new Date(boot.timestamp).getTime() / 1000 / 300) * 300
  : Math.floor(Date.now() / 1000 / 300) * 300;
const ogImageUrl = `https://wx.jamestannahill.com/og.png?v=${ogBucket}`;
---
<Base
  title="wx.jamestannahill.com - Midtown Manhattan Weather"
  description="Live hyperlocal weather data from a private station in Midtown Manhattan, New York. Updated every 5 minutes."
  canonical="https://wx.jamestannahill.com/"
  ogImage={ogImageUrl}
>
  <SchemaOrgIndex slot="schema" />

  <main>
    <header>
      <h1 class="station-label">MIDTOWN MANHATTAN, NEW YORK</h1>
      <span class="updated-at" id="updated-at"><span aria-hidden="true">--</span><span class="sr-only">Not yet updated</span></span>
      <button class="unit-toggle" id="unit-toggle" title="Switch between °F and °C"><span class="sr-only">Temperature unit: </span><span id="unit-toggle-label">°F</span></button>
      <button class="share-btn" id="share-btn" title="Share current conditions on X" aria-label="Share current conditions on X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></button>
      <button class="refresh-btn" id="refresh-btn" title="Refresh now (auto-updates every 5 minutes)" aria-label="Refresh now (auto-updates every 5 minutes)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v5h-5"/></svg></button>
    </header>

    <nav class="jump-row" aria-label="Page sections">
      <a href="#conditions">Conditions</a>
      <a href="#comfort-calendar-section">Calendar</a>
      <a href="#forecast-section">Forecast</a>
      <a href="#history">History</a>
      <a href="#records-section">Records</a>
      <a href="#rain-events-section">Rain</a>
      <a href="#nearby-section">Nearby</a>
    </nav>

    <div class="stale-banner" id="stale-banner" role="status" hidden>
      <span id="stale-msg">Station data may be delayed</span>
    </div>

    <div class="alerts-banner" id="alerts-banner" role="alert" hidden>
      <span id="alerts-msg"></span>
    </div>

    <section class="hero">
      <div class="temp-block">
        <span class="temp" id="temp" set:html={reading(heroTemp)} />
        <span class="temp-unit" id="temp-unit">°F</span>
      </div>
      <div class="feels-like" id="feels-like" set:html={reading(heroFeels)} />
      <div class="condition" id="condition" set:html={reading(heroCond)} />
      <div class="anomaly-headline" id="anomaly-headline">{anomHead}</div>
      <div class="anomaly-subline" id="anomaly-subline">{anomSub}</div>
      <div class="percentile-rank" id="percentile-rank">{percentile}</div>
    </section>

    <section class="climate-panel sr" id="climate-panel" hidden={!(boot?.climate_context?.headline || boot?.climate_context?.verdict)}>
      <div class="climate-panel-header">
        <h2 class="section-title">TODAY IN HISTORY</h2>
        <span class="source-tag has-tooltip" id="climate-source-tag" data-tooltip="">NOAA / ERA5</span>
      </div>
      <div id="climate-metrics"></div>
      <div class="climate-footer" id="climate-footer"></div>
    </section>

    <section class="summary-section tomorrow-section" id="tomorrow-section" hidden>
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
        <p class="summary-date" id="tomorrow-date" style="margin:0"></p>
        <span id="wk-attr-tag" class="source-tag source-external has-tooltip" style="display:inline-flex;align-items:center;gap:5px" data-tooltip="Apple WeatherKit - daily forecast for 40.75°N 73.98°W. Condition, high/low temperature, and wind pulled from Apple's forecast model. Updated every 15 minutes."><img src="weatherkit.png" alt="" style="width:14px;height:14px;border-radius:3px;vertical-align:middle">WEATHERKIT</span>
      </div>
      <p class="summary-text" id="tomorrow-text"></p>
    </section>

    <section class="summary-section today-section" id="today-section" hidden>
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
        <p class="summary-date" style="margin:0">TODAY <span class="live-dot"></span></p>
        <a class="source-tag has-tooltip" href="/docs#cathaus" data-tooltip="CATHAUS: this station's callsign (Ambient WS-2902, KNYNEWYO2140). In-house readings, stats, and ML signals. Click for docs.">CATHAUS</a>
      </div>
      <p class="summary-text" id="today-text"></p>
    </section>

    <section class="summary-section" id="summary-section" hidden>
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
        <p class="summary-date" id="summary-date" style="margin:0"></p>
        <a class="source-tag has-tooltip" href="/docs#cathaus" data-tooltip="CATHAUS: this station's callsign (Ambient WS-2902, KNYNEWYO2140). In-house readings, stats, and ML signals. Click for docs.">CATHAUS</a>
      </div>
      <p class="summary-text" id="summary-text"></p>
    </section>

    <div id="conditions" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
      <h2 class="section-title">CONDITIONS</h2>
      <a class="source-tag has-tooltip" href="/docs#cathaus" data-tooltip="CATHAUS: this station's callsign (Ambient WS-2902, KNYNEWYO2140). In-house readings, stats, and ML signals. Click for docs.">CATHAUS</a>
    </div>
    <section class="conditions-grid">
      <button type="button" class="card card-clickable" data-chart-field="windspeedmph">
        <div class="card-label">WIND</div>
        <div class="card-value" id="wind-speed" set:html={reading(windSpeed)} />
        <div class="card-sub" id="wind-detail" set:html={reading(windDetail)} />
      </button>
      <button type="button" class="card card-clickable" data-chart-field="humidity">
        <div class="card-label">HUMIDITY</div>
        <div class="card-value" id="humidity" set:html={reading(humidity)} />
        <div class="card-sub" id="dewpoint" set:html={reading(dewpoint)} />
      </button>
      <button type="button" class="card card-clickable" data-chart-field="baromrelin">
        <div class="card-label">PRESSURE</div>
        <div class="card-value" id="pressure" set:html={reading(pressure)} />
        <div class="card-sub" id="pressure-trend" set:html={reading(pressureT)} />
      </button>
      <div class="card">
        <div class="card-label">UV INDEX</div>
        <div class="card-value" id="uv" set:html={reading(uv)} />
        <div class="card-sub" id="solar" set:html={reading(solar)} />
      </div>
      <div class="card">
        <div class="card-label">RAINFALL</div>
        <div class="card-value" id="rain-hourly" set:html={reading(rainHourly)} />
        <div class="card-sub" id="rain-daily" set:html={reading(rainDaily)} />
      </div>
      <button type="button" class="card card-clickable" data-chart-field="windspeedmph">
        <div class="card-label">WIND GUST</div>
        <div class="card-value" id="wind-gust" set:html={reading(windGust)} />
        <div class="card-sub" id="wind-dir" set:html={reading(windDir)} />
      </button>
      <div class="card">
        <div class="card-label has-tooltip" data-tooltip="Microclimate Comfort Score (0-100). Composite of feels-like temperature deviation from 71°F ideal, humidity, wind speed, UV index, and rain rate. Season-weighted and adjusted for anomalies vs. this station's own baseline.">COMFORT</div>
        <div class="card-value" id="comfort-score" set:html={reading(comfortScore)} />
        <div class="card-sub" id="comfort-label" set:html={reading(comfortLabel)} />
      </div>
      <div class="card">
        <div class="card-label has-tooltip" data-tooltip="Probability of rain in the next 60 minutes. Logistic regression on humidity, 1-hour pressure trend, dew-point depression, and hour-of-day. Coefficients are refit weekly on this station's labeled history, with NYC heuristics as the fallback. Boosts automatically if rain is currently falling.">RAIN NEXT HOUR</div>
        <div class="card-value" id="rain-prob" set:html={reading(rainProb)} />
        <div class="card-sub" id="rain-prob-label" set:html={reading(rainProbLbl)} />
      </div>
      <button type="button" class="card card-clickable" data-chart-field="uhi_delta">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">
          <div class="card-label has-tooltip" style="margin-bottom:0" data-tooltip="Urban Heat Island delta: this Midtown station minus the average of JFK, LGA, and EWR ASOS readings via NOAA aviationweather.gov. Positive = Midtown warmer than airports. Recomputed with every 5-minute station reading.">URBAN HEAT</div>
          <span class="source-tag source-external" style="padding:1px 5px">NOAA</span>
        </div>
        <div class="card-value" id="uhi-delta" set:html={reading(uhiVal)} />
        <div class="card-sub" id="uhi-label">vs JFK / LGA / EWR</div>
        <div class="card-sub" id="uhi-monthly-avg" style="margin-top:4px;font-size:11px"></div>
      </button>
    </section>

    <section class="comfort-calendar-section" id="comfort-calendar-section">
      <div class="section-header">
        <h2 class="section-title">COMFORT CALENDAR</h2>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="section-meta" id="comfort-meta">30-day history</span>
          <a class="source-tag has-tooltip" href="/docs#cathaus" data-tooltip="CATHAUS, computed: derived in-house from this station's own history (callsign CatHaus, KNYNEWYO2140). Click for docs.">CATHAUS, COMPUTED</a>
        </div>
      </div>
      <div class="comfort-grid" id="comfort-grid" role="list" aria-label="Daily comfort score, last 30 days" aria-busy="true">
        {Array.from({ length: 30 }).map(() => <span class="skel skel-cell" aria-hidden="true" />)}
      </div>
    </section>

    <section class="forecast-section" id="forecast-section">
      <div class="hourly-block" id="hourly-block">
        <div class="hourly-header">
          <h2 class="section-title has-tooltip" data-tooltip="Hour-by-hour conditions, temperature, and precipitation chance for the next 12 hours at 40.75°N 73.98°W.">NEXT 12 HOURS</h2>
          <span id="hourly-attr-tag" class="source-tag source-external has-tooltip" style="display:inline-flex;align-items:center;gap:5px" data-tooltip="Apple WeatherKit hourly forecast for 40.75°N 73.98°W. Condition, temperature, and precipitation probability from Apple's forecast model. Refreshed every 30 minutes."><img src="weatherkit.png" alt="" style="width:14px;height:14px;border-radius:3px;vertical-align:middle">WEATHERKIT</span>
        </div>
        <div class="hourly-strip" id="hourly-strip" aria-busy="true">
          {Array.from({ length: 12 }).map(() => (
            <div class="hourly-cell skel-card" aria-hidden="true">
              <span class="skel skel-line" style="width:24px;height:8px" />
              <span class="skel skel-line" style="width:14px;height:13px" />
              <span class="skel skel-line" style="width:26px;height:12px" />
            </div>
          ))}
        </div>
      </div>
      <div class="analog-block" id="analog-block">
        <div class="forecast-header">
          <h2 class="forecast-title has-tooltip" data-tooltip="Nearest-neighbor pattern matching on 90 days of 5-min station data. Finds the 5 most similar 6-hour weather patterns and averages their subsequent 3-hour trajectories. Recomputed every 30 minutes. Confidence reflects how closely the analogs matched current conditions.">ANALOG FORECAST</h2>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="forecast-meta" id="forecast-meta"></span>
            <a class="source-tag has-tooltip" href="/docs#cathaus" data-tooltip="CATHAUS, computed: derived in-house from this station's own history (callsign CatHaus, KNYNEWYO2140). Click for docs.">CATHAUS, COMPUTED</a>
          </div>
        </div>
        <div class="forecast-grid" id="forecast-grid" aria-busy="true">
          {Array.from({ length: 3 }).map(() => (
            <div class="forecast-card skel-card" aria-hidden="true">
              <span class="skel skel-line" style="width:48px" />
              <span class="skel skel-line skel-tall" style="width:72px" />
              <span class="skel skel-line" style="width:110px" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <Chart apiBase={API_BASE} client:visible />

    <section class="records-section" id="records-section">
      <div class="section-header">
        <h2 class="section-title">STATION RECORDS</h2>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="section-meta" id="records-month"></span>
          <a class="source-tag has-tooltip" href="/docs#cathaus" data-tooltip="CATHAUS: this station's callsign (Ambient WS-2902, KNYNEWYO2140). In-house readings, stats, and ML signals. Click for docs.">CATHAUS</a>
        </div>
      </div>
      <div class="records-grid" id="records-grid" aria-busy="true">
        {Array.from({ length: 6 }).map(() => (
          <div class="record-card skel-card" aria-hidden="true">
            <span class="skel skel-line" style="width:64px" />
            <span class="skel skel-line skel-tall" style="width:88px" />
            <span class="skel skel-line" style="width:52px" />
          </div>
        ))}
      </div>
    </section>

    <section class="rain-events-section" id="rain-events-section">
      <div class="section-header">
        <h2 class="section-title">RECENT RAIN</h2>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="section-meta" id="rain-events-meta">Last 14 days</span>
          <a class="source-tag has-tooltip" href="/docs#cathaus" data-tooltip="CATHAUS: this station's callsign (Ambient WS-2902, KNYNEWYO2140). In-house readings, stats, and ML signals. Click for docs.">CATHAUS</a>
        </div>
      </div>
      <div class="rain-events-list" id="rain-events-list" aria-busy="true">
        <div class="rain-event-row skel-card" aria-hidden="true">
          <span class="skel skel-line" style="width:120px" />
          <span class="skel skel-line" style="width:80px" />
        </div>
      </div>
    </section>

    <!-- Nearby Stations -->
    <section class="nearby-section" id="nearby-section">
      <div class="section-header">
        <h2 class="section-title">NEARBY STATIONS</h2>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="section-meta" id="nearby-meta"></span>
          <span class="source-tag source-external">WEATHER UNDERGROUND</span>
        </div>
      </div>
      <div class="nearby-variance" id="nearby-variance" hidden></div>
      <div class="nearby-strip" id="nearby-strip" aria-busy="true">
        {Array.from({ length: 5 }).map(() => (
          <div class="nearby-chip skel-card" aria-hidden="true">
            <span class="skel skel-line" style="width:70px" />
            <span class="skel skel-line skel-tall" style="width:44px" />
            <span class="skel skel-line" style="width:36px" />
          </div>
        ))}
      </div>
    </section>

    <footer>
      <p>Data from a private weather station in Midtown Manhattan, New York. Updated every 5 minutes.</p>
      <p class="footer-links"><span>40.75°N 73.98°W</span> <a href="https://api.wx.jamestannahill.com/current" target="_blank">API</a> <a href="/docs" data-astro-prefetch>How it works</a> <a href="/embed">Embed</a></p>
    </footer>
  </main>

  {boot && (
    <script is:inline set:html={`(function(){try{localStorage.setItem('wx_current',JSON.stringify({d:${JSON.stringify(boot)},t:Date.now()}));}catch(e){}})();`} />
  )}

  <script src="/app.js" is:inline></script>

</Base>
